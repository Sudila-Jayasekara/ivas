meta {
  name: Get Instructor Assessments
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/instructors/{{instructor_id}}/assessments
  body: none
  auth: none
}

query {
  ~assignment_id: assign-001
  ~student_id: stud-001
  ~status: completed
  ~start_date: 2026-01-01T00:00:00Z
  ~end_date: 2026-12-31T23:59:59Z
}

vars:pre-request {
  base_url: http://localhost:8080
  instructor_id: inst-001
}
