meta {
  name: Generate Questions
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/assignments/:id/generate-questions
  body: json
  auth: none
}

params:path {
  id: assign-003
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Introduction to Python Loops",
