# Application
APP_NAME=ivas-api
APP_ENV=development
APP_DEBUG=true

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ivas_db
DB_SSL_MODE=disable

# JWT
JWT_SECRET=dev-secret-key-not-for-production
JWT_EXPIRY_HOURS=24

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# AI
AI_SERVICE_URL=http://localhost:8081
# AI_SERVICE_TIMEOUT= 

# PGADMIN
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050