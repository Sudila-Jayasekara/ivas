meta {
  name: Generate Questions
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/assignments/:assignment_id/questions/generate
  body: none
  auth: none
}

params:path {
  assignment_id: {{assignment_id}}
}

docs {
  API 4 — Generate questions from saved grading criteria.
  Requires grading criteria to already exist for the assignment
  (run "Generate Grading Criteria" first).
  Generates exactly one question per competency (one per grading-criteria row).
  No request body required.
}
