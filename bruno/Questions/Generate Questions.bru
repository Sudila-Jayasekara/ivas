meta {
  name: Generate Questions
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/assignments/:assignment_id/questions/generate
  body: none
  auth: none
}

params:path {
  assignment_id: {{assignment_id}}
}

docs {
  API 4 — Generate conceptual viva questions from saved grading criteria.
  Requires grading criteria to already exist for the assignment
  (run "Generate Grading Criteria" first).
  Generates exactly two questions per competency/difficulty level.
  Questions focus on conceptual understanding, not code syntax.
  No request body required.
}
