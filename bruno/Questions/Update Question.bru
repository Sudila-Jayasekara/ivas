meta {
  name: Update Question
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/questions/:question_id
  body: json
  auth: none
}

params:path {
  question_id: <REPLACE_WITH_ID>
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "question_text": "Write a Python program that uses a while loop to print all numbers from 1 to n. Explain your reasoning behind the loop's termination condition.",
    "difficulty": 4,
    "modified_by": "inst-001"
  }
}

docs {
  Update question details (partial update)
}
