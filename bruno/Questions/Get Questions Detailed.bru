meta {
  name: Get Questions Detailed
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/assignments/:assignment_id/questions?detailed=true
  body: none
  auth: none
}

params:path {
  assignment_id: assign-001
}

params:query {
  detailed: true
  ~status: approved
  ~competency: loops
  ~question_type: required
}

headers {
  Accept: application/json
}

docs {
  List questions for an assignment with rubric data included. Set detailed=true to include rubrics. Optional filters: status, competency, question_type.
}
