meta {
  name: Get Student Sessions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/students/:student_id/sessions
  body: none
  auth: none
}

params:path {
  student_id: stud-001
}

params:query {
  ~status: in_progress
  ~assignment_id: assign-001
}

headers {
  Accept: application/json
}

docs {
  Get all assessment sessions for a student. Optional filters: status, assignment_id.
}
