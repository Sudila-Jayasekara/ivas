meta {
  name: Submit Response
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/assessments/sessions/e4088b81-8d3e-4e37-9156-a0cd7acfcb48/respond
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "question_instance_id": "{{question_instance_id}}",
    "response_text": "order of opetions will change it will give more priority for operations inside parentheses",
    "response_type": "text"
  }
}

script:post-response {
  const data = res.getBody();
  
  if (data.next_question && data.next_question.question_instance_id) {
    bru.setVar("question_instance_id", data.next_question.question_instance_id);
  }
}

docs {
  Submit a student response to a question in the assessment session.
  response_text should be a conceptual explanation (as if spoken in a viva).
  response_type: "text" for typed answers, "audio" for voice transcriptions.
}
