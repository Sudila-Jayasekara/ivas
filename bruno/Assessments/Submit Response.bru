meta {
  name: Submit Response
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/assessments/sessions/:session_id/respond
  body: json
  auth: none
}

params:path {
  session_id: {{session_id}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "question_instance_id": "{{question_instance_id}}",
    "response_text": "A struct is used to group related data together, like storing a student's name and age in one place",
    "response_type": "text"
  }
}

docs {
  Submit a student response to a question in the assessment session.
  response_text should be a conceptual explanation (as if spoken in a viva).
  response_type: "text" for typed answers, "audio" for voice transcriptions.
}
