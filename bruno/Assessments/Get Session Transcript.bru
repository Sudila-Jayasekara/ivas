meta {
  name: Get Session Transcript
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/assessments/sessions/:session_id/transcript
  body: none
  auth: none
}

params:path {
  session_id: {{session_id}}
}

headers {
  Accept: application/json
}

docs {
  Get full transcript of an assessment session (questions + responses in order)
}
