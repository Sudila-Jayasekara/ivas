meta {
  name: Trigger Assessment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/assessments/trigger
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "student_id": "stud-001",
    "assignment_id": "assign-001",
    "code_context": ""
  }
}

script:post-response {
  const data = res.getBody();
  
  if(data.session_id && data.first_question.question_instance_id){
  bru.setVar("session_id", data.session_id);
  bru.setVar("question_instance_id", data.first_question.question_instance_id);
  }
}

docs {
  Trigger a new assessment session for a student.
  The viva checks conceptual understanding — not code correctness.
  code_context is optional background reference only.
}
