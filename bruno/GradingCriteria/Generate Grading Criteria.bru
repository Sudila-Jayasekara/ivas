meta {
  name: Generate Grading Criteria
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/assignments/:assignment_id/grading-criteria/generate
  body: json
  auth: none
}

params:path {
  assignment_id: {{assignment_id}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "assignment_text": "You are given the heights in meters of ten mountains Write a Java program that reads these heights and prints the heights of the top three mountains in descending order The program should read 10 integers from standard input Each integer represents the height of a mountain Each height is an integer between 0 and 10000 Print the three largest heights each on a separate line in descending order Example sample input 1819 2003 876 2840 1723 1673 3776 2848 1592 922 Sample output 3776 2848 2840 Use Java built in sorting methods or implement your own sorting logic Ensure your output matches the required format exactly Focus on clean readable code and proper use of Java syntax"
  }
}

docs {
  API 1 — Lecturer provides raw assignment text.
  AI extracts: competencies, difficulty levels, Bloom's taxonomy labels,
  marking criteria, programming language, and learning objectives.
  All results are saved as GradingCriteria rows in the database.
  Re-running this endpoint replaces any previously generated criteria for the assignment.
}
