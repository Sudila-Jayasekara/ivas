meta {
  name: Get Grading Criteria
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/assignments/:assignment_id/grading-criteria
  body: none
  auth: none
}

params:path {
  assignment_id: {{assignment_id}}
}

headers {
  Accept: application/json
}

docs {
  API 2 — Lecturer reviews all grading criteria AI extracted for the assignment.
  Returns a list ordered by difficulty_level ascending.
  Each row contains: competency, difficulty_level, level_label, level_description,
  marking_criteria, max_points, programming_language, learning_objectives.
}
